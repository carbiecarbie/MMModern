include_guard(GLOBAL)
if(WIN32)
 set(MMODERN_SCUMMVM_DEFINES WIN32 UNICODE _UNICODE)
else()
 file(STRINGS "${SCUMMVM_BUILD_DIR}/config.mk" lines REGEX "^DEFINES[ \t]*[+:]?=")
 set(found "HAVE_CONFIG_H")
 foreach(line IN LISTS lines)
  string(REGEX REPLACE "^DEFINES[ \t]*[+:]?=[ \t]*" "" line "${line}")
  separate_arguments(entries UNIX_COMMAND "${line}")
  foreach(entry IN LISTS entries)
   if(NOT entry MATCHES "^-D")
    message(FATAL_ERROR "Unexpected ScummVM define: ${entry}")
   endif()
   string(SUBSTRING "${entry}" 2 -1 entry)
   list(APPEND found "${entry}")
  endforeach()
 endforeach()
 if(APPLE)
  set(define_allowlist "${CMAKE_CURRENT_LIST_DIR}/../.github/ci/scummvm-defines-macos.txt")
 else()
  set(define_allowlist "${CMAKE_CURRENT_LIST_DIR}/../.github/ci/scummvm-defines-linux.txt")
 endif()
 file(STRINGS "${define_allowlist}" expected)
 list(SORT found)
 list(SORT expected)
 if(NOT found STREQUAL expected)
  message(FATAL_ERROR "ScummVM ${CMAKE_SYSTEM_NAME} defines differ from the allowlist: ${found}")
 endif()
 set(MMODERN_SCUMMVM_DEFINES "${found}")
 # Expand the configured make variables exactly as the artifact compilation does.
 file(STRINGS "${SCUMMVM_BUILD_DIR}/config.mk" prefix REGEX "^prefix = ")
 string(REPLACE "prefix = " "" prefix "${prefix}")
 string(REPLACE "\${datarootdir}" "${prefix}/share" MMODERN_SCUMMVM_DEFINES "${MMODERN_SCUMMVM_DEFINES}")
 string(REPLACE "\${exec_prefix}" "${prefix}" MMODERN_SCUMMVM_DEFINES "${MMODERN_SCUMMVM_DEFINES}")
endif()
set(MMODERN_SCUMMVM_DEFINE_FLAGS "")
foreach(define IN LISTS MMODERN_SCUMMVM_DEFINES)
 list(APPEND MMODERN_SCUMMVM_DEFINE_FLAGS "-D${define}")
endforeach()
