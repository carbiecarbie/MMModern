# C shared-library imports have no definition in project objects. This is the
# whole exemption list; project C++ symbols always require a real definition.
set(MMODERN_WRAP_SHARED_EXEMPTIONS
 SDL_CreateRenderer SDL_OpenAudioDevice SDL_AudioStreamGet SDL_GetTicks
 SDL_PumpEvents SDL_WaitEventTimeout SDL_UpdateTexture SDL_RenderCopy
 SDL_FilterEvents SDL_PollEvent SDL_NewAudioStream SDL_GetAudioDeviceStatus
 SDL_GetDefaultAudioInfo SDL_GetTicks64 SDL_Delay SDL_RenderPresent
 SHGetKnownFolderPath fsync
 # libc rename: POSIX DOS export test injects a kernel permission failure.
 rename)
function(mmodern_guard_wraps)
 get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
 foreach(target IN LISTS targets)
  get_target_property(options ${target} LINK_OPTIONS)
  foreach(option IN LISTS options)
   if(option MATCHES "--wrap[,=](_Z[A-Za-z0-9_]+)")
    target_link_options(${target} PRIVATE "LINKER:--require-defined,${CMAKE_MATCH_1}")
   elseif(option MATCHES "--wrap[,=]([A-Za-z_][A-Za-z0-9_]*)" AND NOT CMAKE_MATCH_1 IN_LIST MMODERN_WRAP_SHARED_EXEMPTIONS)
    message(FATAL_ERROR "Unlisted shared-library wrap: ${option}")
   endif()
  endforeach()
 endforeach()
endfunction()
