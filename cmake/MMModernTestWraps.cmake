# Test-only Itanium ABI spellings, shared by linker options and C++ asm labels.
# Probe the compiler rather than assuming the platform's typedefs.
set(abi_probe "${CMAKE_CURRENT_BINARY_DIR}/xeen-test-abi.cpp")
file(WRITE "${abi_probe}" "#include <cstddef>\n#include <cstdint>\nvoid size_abi(std::size_t){}\nvoid uint_abi(std::uint64_t){}\n")
function(xeen_test_abi_probe)
 set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
 set(CMAKE_TRY_COMPILE_CONFIGURATION "${CMAKE_BUILD_TYPE}")
 try_compile(abi_result "${CMAKE_CURRENT_BINARY_DIR}/xeen-test-abi-build" "${abi_probe}"
  COPY_FILE "${CMAKE_CURRENT_BINARY_DIR}/xeen-test-abi.a"
  OUTPUT_VARIABLE abi_output)
 file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/xeen-test-abi-build.log" "${abi_output}")
 if(NOT abi_result)
  message(FATAL_ERROR "Cannot derive test ABI manglings: ${abi_output}")
 endif()
 execute_process(COMMAND "${CMAKE_NM}" --defined-only "${CMAKE_CURRENT_BINARY_DIR}/xeen-test-abi.a"
  OUTPUT_VARIABLE abi_symbols RESULT_VARIABLE nm_result)
 if(NOT nm_result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect test ABI manglings")
 endif()
 set(abi_assembly "${abi_symbols}" PARENT_SCOPE)
endfunction()
xeen_test_abi_probe()
foreach(pair IN ITEMS "SIZE_T;size" "UINT64_T;uint")
 list(GET pair 0 type)
 list(GET pair 1 function)
 string(REGEX MATCH "_Z8${function}_abi([a-z])" match "${abi_assembly}")
 if(NOT match)
  message(FATAL_ERROR "Cannot find ${type} compiler mangling")
 endif()
 set(MMODERN_ABI_${type} "${CMAKE_MATCH_1}")
endforeach()
set(wrap_header "#pragma once\n")
function(xeen_wrap_symbol name spelling)
 string(CONFIGURE "${spelling}" symbol @ONLY)
 set(${name} "${symbol}" PARENT_SCOPE)
 set(wrap_header "${wrap_header}#define ${name} \"${symbol}\"\n" PARENT_SCOPE)
endfunction()
