cmake_minimum_required(VERSION 3.20)
function(git result repository)
 execute_process(COMMAND "${Git}" -C "${repository}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
 if(NOT status EQUAL 0)
  message(FATAL_ERROR "Fixture Git: ${error}")
 endif()
 set(${result} "${text}" PARENT_SCOPE)
endfunction()
# A separate native fixture writer supplies binary input (including NUL bytes).
# It never reads the installed game or the generator's implementation.
function(fixture name mode)
 set(source "${TestRoot}/${name}")
 file(MAKE_DIRECTORY "${source}/devtools/create_mm/files/xeen")
 execute_process(COMMAND "${FixtureWriter}" "${source}/devtools/create_mm/files/xeen/CONSTANTS_7" "${mode}" RESULT_VARIABLE status)
 if(NOT status EQUAL 0)
  message(FATAL_ERROR "Fixture writer failed")
 endif()
 git(unused "${source}" init -q)
 git(unused "${source}" -c user.name=MMModern -c user.email=test@example.invalid add .)
 git(unused "${source}" -c user.name=MMModern -c user.email=test@example.invalid commit -qm fixture)
 git(revision "${source}" rev-parse HEAD)
 git(oid "${source}" hash-object -- devtools/create_mm/files/xeen/CONSTANTS_7)
 file(SHA256 "${source}/devtools/create_mm/files/xeen/CONSTANTS_7" sha)
 set(Source "${source}" PARENT_SCOPE)
 set(Revision "${revision}" PARENT_SCOPE)
 set(Oid "${oid}" PARENT_SCOPE)
 set(Sha "${sha}" PARENT_SCOPE)
endfunction()
function(generate expected)
 execute_process(COMMAND "${CMAKE_COMMAND}" "-DSource=${Source}" "-DRevision=${Revision}" "-DGit=${Git}" "-DExpectedBlobOid=${Oid}" "-DExpectedBlobSha256=${Sha}" "-DOutput=${output}" -P "${Generator}" RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE error)
 if(expected AND NOT status EQUAL 0)
  message(FATAL_ERROR "Generator failed: ${log}${error}")
 elseif(NOT expected AND status EQUAL 0)
  message(FATAL_ERROR "Generator unexpectedly accepted invalid input")
 elseif(NOT expected AND NOT "${log}${error}" MATCHES "Item catalog generation failed:")
  message(FATAL_ERROR "Generator did not report its error: ${log}${error}")
 endif()
endfunction()
string(RANDOM LENGTH 16 nonce)
set(TestRoot "${TestRoot}/run-${nonce}")
file(MAKE_DIRECTORY "${TestRoot}")
fixture(valid valid)
set(output "${TestRoot}/generated/catalog.inc")
generate(TRUE)
file(READ "${output}" text)
foreach(fragment "kSchema = 1" "kLanguage = 7" "kBonusNames" "kWeaponNames" "kSpecialNames")
 string(FIND "${text}" "${fragment}" at)
 if(at LESS 0)
  message(FATAL_ERROR "Missing generated ${fragment}")
 endif()
endforeach()
file(SHA256 "${output}" initial)
file(TIMESTAMP "${output}" timestamp "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
generate(TRUE)
file(TIMESTAMP "${output}" unchanged "%s")
if(NOT timestamp STREQUAL unchanged)
 message(FATAL_ERROR "Unchanged generation replaced output")
endif()
set(original "${output}")
set(output "${TestRoot}/replacement path with spaces/generated catalog.inc")
file(WRITE "${output}" "previous valid include")
generate(TRUE)
file(SHA256 "${output}" replaced)
if(NOT initial STREQUAL replaced)
 message(FATAL_ERROR "Changed-output replacement bytes differ")
endif()
file(GLOB temps "${output}.tmp-*")
if(temps)
 message(FATAL_ERROR "Publication left temporary files")
endif()
if(CMAKE_HOST_WIN32)
 set(output "${TestRoot}/locked/catalog.inc")
 file(WRITE "${output}" "last valid include")
 execute_process(COMMAND powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "${CMAKE_CURRENT_LIST_DIR}/XeenItemCatalogDestinationLock.ps1"
  -Path "${output}" -CMake "${CMAKE_COMMAND}" -Generator "${Generator}" -Source "${Source}" -Revision "${Revision}" -Git "${Git}" -Oid "${Oid}" -Sha "${Sha}" RESULT_VARIABLE status)
 if(NOT status EQUAL 0)
  message(FATAL_ERROR "Locked-destination refusal failed")
 endif()
 file(READ "${output}" preserved)
 file(GLOB temps "${output}.tmp-*")
 if(NOT preserved STREQUAL "last valid include" OR temps)
  message(FATAL_ERROR "Locked destination was changed or temporary leaked")
 endif()
endif()
set(output "${original}")
file(WRITE "${Source}/devtools/create_mm/files/xeen/CONSTANTS_7" "mutable worktree")
file(WRITE "${Source}/forced.h" "#error forced input")
file(WRITE "${Source}/options.rsp" "--include=forced.h")
file(WRITE "${Source}/devtools/create_mm/files/xeen/CONSTANTS_7.gch" "PCH")
set(ENV{CXXFLAGS} "--include=forced.h @options.rsp")
set(ENV{CPLUS_INCLUDE_PATH} "${Source}")
# All case variants of GIT_* must be scrubbed by the generator.
set(ENV{GIT_DIR} "${TestRoot}/absent")
set(ENV{git_work_tree} "${TestRoot}/absent")
generate(TRUE)
unset(ENV{GIT_DIR})
unset(ENV{git_work_tree})
file(SHA256 "${output}" regenerated)
if(NOT initial STREQUAL regenerated)
 message(FATAL_ERROR "Mutable worktree/compiler/environment affected output")
endif()
set(savedRevision "${Revision}")
set(savedOid "${Oid}")
set(savedSha "${Sha}")
string(REPEAT 0 40 zero)
set(Revision "${zero}")
generate(FALSE)
set(Revision "${savedRevision}")
set(Oid "${zero}")
generate(FALSE)
set(Oid "${savedOid}")
string(REPEAT 0 64 Sha)
generate(FALSE)
set(Sha "${savedSha}")
git(unused "${Source}" add devtools/create_mm/files/xeen/CONSTANTS_7)
git(unused "${Source}" -c user.name=MMModern -c user.email=test@example.invalid commit -qm changed)
generate(FALSE)
foreach(mode bad-count oversized truncated empty-scalar reserved required end-offset)
 fixture("${mode}" "${mode}")
 set(output "${TestRoot}/${mode}.inc")
 file(WRITE "${output}" "last valid include")
 generate(FALSE)
 file(READ "${output}" preserved)
 if(NOT preserved STREQUAL "last valid include")
  message(FATAL_ERROR "Invalid input partially published output")
 endif()
endforeach()
foreach(pair "${ProductionOutput}|${ProductionOutputSha256}" "${DialogOutput}|${DialogOutputSha256}")
 string(REPLACE "|" ";" pair "${pair}")
 list(GET pair 0 path)
 list(GET pair 1 expected)
 file(SHA256 "${path}" sha)
 if(NOT sha STREQUAL expected)
  message(FATAL_ERROR "Production generated include identity differs: ${path}")
 endif()
endforeach()
message(STATUS "Pinned-blob generation and refusal tests passed")
