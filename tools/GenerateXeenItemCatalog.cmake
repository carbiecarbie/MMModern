cmake_minimum_required(VERSION 3.20)

function(fail text)
 message(FATAL_ERROR "Item catalog generation failed: ${text}")
endfunction()
foreach(key Source Revision Git ExpectedBlobOid ExpectedBlobSha256 Output)
 if(NOT DEFINED ${key})
  fail("Missing ${key}")
 endif()
endforeach()
get_filename_component(Source "${Source}" ABSOLUTE)
if(NOT EXISTS "${Source}/.git")
 fail("ScummVM source is not a Git checkout")
endif()
foreach(pair Revision:40 ExpectedBlobOid:40 ExpectedBlobSha256:64)
 string(REPLACE ":" ";" pair "${pair}")
 list(GET pair 0 key)
 list(GET pair 1 count)
 string(LENGTH "${${key}}" length)
 if(NOT length EQUAL count OR NOT "${${key}}" MATCHES "^[0-9a-f]+$")
  fail("Invalid pinned catalog identity")
 endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E environment OUTPUT_VARIABLE environment)
string(REPLACE "\n" ";" environment "${environment}")
set(env_command "${CMAKE_COMMAND}" -E env)
foreach(entry IN LISTS environment)
 if(entry MATCHES "^([^=]+)=")
  set(key "${CMAKE_MATCH_1}")
  string(TOUPPER "${key}" upper)
  if(upper MATCHES "^GIT_")
   list(APPEND env_command "--unset=${key}")
  endif()
 endif()
endforeach()
if(CMAKE_HOST_WIN32)
 set(null NUL)
else()
 set(null /dev/null)
endif()
list(APPEND env_command GIT_CONFIG_NOSYSTEM=1 "GIT_CONFIG_GLOBAL=${null}" GIT_NO_REPLACE_OBJECTS=1)
set(git_command ${env_command} "${Git}" --no-replace-objects -c "safe.directory=${Source}" -C "${Source}")
function(git_text result)
 execute_process(COMMAND ${git_command} ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE value ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
 if(NOT status EQUAL 0)
  fail("Git plumbing failed: ${error}")
 endif()
 set(${result} "${value}" PARENT_SCOPE)
endfunction()
git_text(directory rev-parse --absolute-git-dir)
list(APPEND git_command "--git-dir=${directory}")
git_text(head rev-parse --verify HEAD)
if(NOT head STREQUAL Revision)
 fail("ScummVM catalog source revision mismatch")
endif()
set(blob_path devtools/create_mm/files/xeen/CONSTANTS_7)
git_text(entry ls-tree "${Revision}" -- "${blob_path}")
if(NOT entry STREQUAL "100644 blob ${ExpectedBlobOid}\t${blob_path}")
 fail("Pinned CONSTANTS_7 tree entry differs")
endif()
get_filename_component(directory "${Output}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(temporary "${Output}.tmp-${nonce}")
execute_process(COMMAND ${git_command} cat-file blob "${ExpectedBlobOid}" OUTPUT_FILE "${temporary}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
 file(REMOVE "${temporary}")
 fail("Git blob read failed")
endif()
file(SIZE "${temporary}" size)
file(SHA256 "${temporary}" sha)
file(READ "${temporary}" hex HEX)
file(REMOVE "${temporary}")
if(NOT size EQUAL 35065 OR NOT sha STREQUAL ExpectedBlobSha256)
 fail("Pinned CONSTANTS_7 content identity differs")
endif()
function(byte at result)
 math(EXPR index "${at} * 2")
 string(SUBSTRING "${hex}" ${index} 2 value)
 math(EXPR value "0x${value}")
 set(${result} ${value} PARENT_SCOPE)
endfunction()
function(octal input result)
 string(LENGTH "${input}" length)
 set(value "\"")
 while(length GREATER 0)
  string(SUBSTRING "${input}" 0 2 b)
  string(SUBSTRING "${input}" 2 -1 input)
  math(EXPR a "(0x${b} >> 6) & 7")
  math(EXPR b1 "(0x${b} >> 3) & 7")
  math(EXPR c "0x${b} & 7")
  string(APPEND value "\\${a}${b1}${c}")
  math(EXPR length "${length} - 2")
 endwhile()
 set(${result} "${value}\"" PARENT_SCOPE)
endfunction()
function(token result)
 set(start ${position})
 while(position LESS 22438)
  byte(${position} b)
  if(b EQUAL 0)
   break()
  endif()
  math(EXPR position "${position} + 1")
 endwhile()
 math(EXPR length "${position} - ${start}")
 if(position GREATER_EQUAL 22438 OR length GREATER 63)
  fail("Truncated or oversized catalog token")
 endif()
 math(EXPR start "${start} * 2")
 math(EXPR length "${length} * 2")
 string(SUBSTRING "${hex}" ${start} ${length} value)
 octal("${value}" value)
 math(EXPR position "${position} + 1")
 set(position ${position} PARENT_SCOPE)
 set(${result} "${value}" PARENT_SCOPE)
endfunction()
if(DialogDrawing)
 set(text "/* ScummVM ${Revision}; GPL-3.0-or-later; ScummVM developers (COPYRIGHT). Numeric drawing data only. */\nnamespace mmodern::generated_dialog_drawing {\n")
 foreach(table WindowSymbols:2891:20:64 TextColors:4175:40:4 StartupTextColors:4339:40:4)
  string(REPLACE ":" ";" table "${table}")
  list(GET table 0 name)
  list(GET table 1 position)
  list(GET table 2 rows)
  list(GET table 3 columns)
  foreach(expected 0 0 ${columns} ${rows})
   byte(${position} b)
   if(NOT b EQUAL expected)
    fail("Dialog drawing array tag mismatch")
   endif()
   math(EXPR position "${position} + 1")
  endforeach()
  string(APPEND text "inline constexpr std::array<std::array<unsigned char, ${columns}>, ${rows}> k${name}{{\n")
  foreach(row RANGE 1 ${rows})
   set(values "")
   foreach(column RANGE 1 ${columns})
    byte(${position} b)
    if(column GREATER 1)
     string(APPEND values ",")
    endif()
    string(APPEND values "${b}")
    math(EXPR position "${position} + 1")
   endforeach()
   string(APPEND text "{{${values}}},\n")
  endforeach()
  string(APPEND text "}};\n")
 endforeach()
 string(APPEND text "} // namespace mmodern::generated_dialog_drawing\n")
 set(limit 65536)
else()
 set(text "/* Generated from ScummVM ${Revision}; GPL-3.0-or-later; see docs/dependencies.md and ScummVM COPYRIGHT. */\nnamespace mmodern::generated_item_catalog {\ninline constexpr unsigned kSchema = 1;\ninline constexpr unsigned kLanguage = 7;\n")
 string(HEX "${Revision}" revision_hex)
 octal("${revision_hex}" literal)
 string(APPEND text "inline constexpr std::string_view kSourceRevision = ${literal};\n")
 set(position 20680)
 foreach(name ItemBroken ItemCursed ItemOf)
  token(value)
  if(value STREQUAL "\"\"")
   fail("Catalog scalar is empty")
  endif()
  string(APPEND text "inline constexpr std::string_view k${name} = ${value};\n")
 endforeach()
 foreach(table BonusNames:7 WeaponNames:41 ArmorNames:14 AccessoryNames:11 MiscNames:22 SpecialNames:74)
  string(REPLACE ":" ";" table "${table}")
  list(GET table 0 name)
  list(GET table 1 count)
  foreach(expected 0 0 0 ${count})
   byte(${position} b)
   if(NOT b EQUAL expected)
    fail("Catalog array count tag mismatch")
   endif()
   math(EXPR position "${position} + 1")
  endforeach()
  string(APPEND text "inline constexpr std::array<std::string_view, ${count}> k${name}{{\n")
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
   token(value)
   if((index EQUAL 0 AND NOT value STREQUAL "\"\"") OR (index GREATER 0 AND value STREQUAL "\"\""))
    fail("Catalog reserved/required entry mismatch")
   endif()
   string(APPEND text "\t${value},\n")
  endforeach()
  string(APPEND text "}};\n")
 endforeach()
 if(NOT position EQUAL 22438)
  fail("Catalog block end offset differs")
 endif()
 string(APPEND text "} // namespace mmodern::generated_item_catalog\n")
 set(limit 16384)
endif()
string(LENGTH "${text}" size)
if(DEFINED ExpectedOutputSha256)
 string(SHA256 output_sha "${text}")
 if(NOT output_sha STREQUAL ExpectedOutputSha256)
  fail("Generated include identity differs")
 endif()
endif()
if(size GREATER limit)
 fail("Generated include exceeds bound")
endif()
if(EXISTS "${Output}")
 file(SHA256 "${Output}" previous)
 string(SHA256 expected "${text}")
 if(previous STREQUAL expected)
  return()
 endif()
endif()
file(CONFIGURE OUTPUT "${temporary}" CONTENT "${text}" @ONLY NEWLINE_STYLE UNIX)
execute_process(COMMAND "${CMAKE_COMMAND}" -E rename "${temporary}" "${Output}" RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
 file(REMOVE "${temporary}")
 fail("Publish include: ${error}")
endif()
